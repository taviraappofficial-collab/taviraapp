{
  "expo": {
    "name": "TAVIRA",
    "slug": "tavira",
    "scheme": "tavira",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": ["expo-router", "expo-secure-store"],
    "android": {
      "package": "com.tavira.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.tavira.app",
      "buildNumber": "1"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
